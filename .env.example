# Copy to .env and fill in real values locally, OR export these in your shell.
# Never commit a real .env file. Spring Boot does not load .env by default;
# supply variables from the terminal/IDE instead.

# JDBC URL for the application database. If DB_URL is set it wins over the
# parts below. Otherwise the URL is composed as
#   jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
# so you can supply either one full JDBC URL or the three parts.
DB_URL=jdbc:postgresql://localhost:5432/donation_matching_portal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=donation_matching_portal
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080

# JWT signing secret. REQUIRED for the application to start.
# Generate a strong random secret of at least 32 bytes, e.g.:
#   openssl rand -base64 48
# Do NOT commit a real secret to source control.
JWT_SECRET=

# Access token lifetime in milliseconds (default 1 hour).
JWT_EXPIRATION_MS=3600000

# Admin seeding. When BOTH are set, an ADMIN account (email/password) is
# created automatically on startup if it does not exist yet. Set neither or
# both; setting only one fails fast at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Restricted CORS: comma-separated list of origins allowed to call /api/**.
# Leave empty to disable browser cross-origin access entirely.
# Example: CORS_ALLOWED_ORIGINS=https://demo.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
